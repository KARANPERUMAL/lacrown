# ==============================================================================
# La Crown Aesthetic Clinic - Production Environment Variables
# Copy this file to .env for local development.
# On Render (Backend) and Neon (Database), set these in your dashboard settings.
# ==============================================================================

# Server Configuration
PORT=8000
NODE_ENV=development

# Frontend CORS Origin
# In local dev: http://localhost:5050,http://127.0.0.1:5500
# In production on Render: Set this to your Vercel deployment URL (e.g. https://la-crown.vercel.app)
CLIENT_ORIGIN=http://localhost:5050,http://localhost:3000,http://127.0.0.1:5500

# ==============================================================================
# Database Configuration (Neon PostgreSQL)
# ==============================================================================
# Get this from your Neon Console (https://console.neon.tech)
# Example: postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-patient-dawn-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# Email Configuration (Resend API)
# ==============================================================================
# Get your API Key from Resend Dashboard (https://resend.com/api-keys)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# The manager's email address where all form submission alert emails will be delivered
MANAGER_EMAIL=manager@lacrownclinic.com

# Verified sender email address configured in your Resend account
# Note: For free trial accounts without a custom domain, use: onboarding@resend.dev
# Once your domain is verified on Resend, use: concierge@yourdomain.com
EMAIL_FROM="La Crown Concierge <onboarding@resend.dev>"

# Optional: CC or BCC address for audit logs (leave empty if not needed)
AUDIT_EMAIL=

# ==============================================================================
# Security & Administrative Settings
# ==============================================================================
# Optional secret key for securing administrative endpoints (e.g., GET /api/appointments)
ADMIN_SECRET_KEY=change-this-to-a-secure-random-token-in-production

# Clinic Branding Metadata
CLINIC_NAME="La Crown Luxury Aesthetic Clinic"
CLINIC_PHONE="+91 96061 51079"
CLINIC_ADDRESS="No. 37, Ashoka Pillar Road, 2nd Block, Jayanagar, Bengaluru 560011"
