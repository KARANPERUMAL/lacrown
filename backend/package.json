{
  "name": "la-crown-backend",
  "version": "1.0.0",
  "description": "Production REST API for La Crown Luxury Aesthetic Clinic - Powered by Node.js, Express, Neon PostgreSQL, and Resend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node -e \"require('./src/config/db').initDb().then(() => process.exit(0))\""
  },
  "keywords": [
    "aesthetic-clinic",
    "resend",
    "neon",
    "render",
    "express"
  ],
  "author": "La Crown Engineering Team",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.3",
    "resend": "^4.1.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
